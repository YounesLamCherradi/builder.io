# Supabase Configuration
# Get these values from your Supabase project settings (Settings → API)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Dashboard Credentials
# Set these to secure your admin dashboard
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=secure_password_here

# Email Service Configuration (Resend)
# Get your API key from https://resend.com
# 1. Sign up at https://resend.com
# 2. Go to API Keys section
# 3. Create a new API key and paste it here
RESEND_API_KEY=your_resend_api_key_here

# Example:
# VITE_SUPABASE_URL=https://abcdefg.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# RESEND_API_KEY=re_1234567890abcdefgh
